flowchart TB
    User([User]) --> HTML["index.html\nStudio shell"]

    subgraph App["ES Modules"]
        HTML --> app["app.js\nEntry point"]
        app --> state["state.js\nDraft spec + name"]
        app --> render["render.js\nHero, tiles, colours, secrets"]
        app --> events["events.js\nClicks, keys, unlock celebrations"]
        events --> wardrobe["wardrobe.js\nUnlock rules"]
        events --> exportm["export.js\nCode, link, PNG"]
        render & state & exportm --> kit["neorgon-avatar.js\nShared Avatar Kit (vendored)"]
    end

    state <-->|"paperdoll-v1"| Storage[("localStorage")]
    kit <-->|"neo_character / neo_unlocks"| Cookie[("*.neorgon.com cookie")]
    Cookie --> Floorplan["floorplan.neorgon.com\nUse my character"]
